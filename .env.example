# GEMINI_API_KEY: Primary AI Engine
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# AZURE_SPEECH_KEY & AZURE_SPEECH_REGION: Microsoft Azure Neural TTS
# https://portal.azure.com -> Speech service
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"

# MISTRAL_API_KEY & MISTRAL_MODEL: Fallback LLM Engine 1
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# OPENAI_API_KEY: Fallback LLM Engine 2 (ChatGPT)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# YOU_TUBE_API_KEY: YouTube Data API
YOU_TUBE_API_KEY=""

# AUTH_SECRET: signs session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production: without it every restart logs everyone out.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Vercel only. Leave blank for local development — accounts then live in
# data/users.json on disk.
#
# Vercel's filesystem is read-only, so deployed accounts are kept in the same
# JSON document inside a private Blob store instead. Create one under
# Project -> Storage -> Create Database -> Blob -> Private, connect it to the
# project, and Vercel injects BLOB_STORE_ID plus OIDC credentials automatically.
# BLOB_READ_WRITE_TOKEN is only needed when running outside Vercel.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
